# Secrets: environment files hold production credentials (database URL, API keys,
# Firebase service account) and must never be committed. Example templates are allowed.
.env
.env.*
!.env.example

# Python bytecode caches
__pycache__/
*.pyc

# Brainstorming mockups (local only)
.superpowers/

# Source art and design exports (the mascot pack is about 31 MB). Only the files the
# app and landing page use are copied into frontend/assets/ and landing/assets/.
Claude outputs/
